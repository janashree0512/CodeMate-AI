# ==============================================================================
# CodeMate AI - Environment Configuration Template
# Copy this file to '.env' and populate your sensitive credentials.
# NEVER commit the actual '.env' file to source control.
# ==============================================================================

# Groq API Credentials (Required for LLM interaction)
# Obtain your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LLM Model Configuration
# Supported tool-calling models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama3-70b-8192
MODEL_NAME=llama-3.3-70b-versatile

# Agent Execution Limits
# Maximum ReAct self-correction attempts before terminating
MAX_ITERATIONS=10

# Code Execution Timeout (seconds)
# Hard timeout to prevent infinite loops or long-running processes
EXECUTION_TIMEOUT_SECONDS=10

# Human-in-the-Loop Safety Gate
# Require explicit user approval before executing code or performing destructive file operations
REQUIRE_USER_APPROVAL=true

# Workspace Directory
# Relative or absolute path to the restricted workspace for file creation and execution
WORKSPACE_DIR=workspace

# Output Truncation (Stage 2)
# Maximum characters of tool output (stdout/stderr/file content) sent back to the LLM
MAX_TOOL_OUTPUT_CHARS=4000

# Conversation History Limit (Stage 2)
# Maximum number of messages kept in the conversation window
# (system prompt + original task are always kept; oldest tool results are compressed when exceeded)
MAX_HISTORY_MESSAGES=30
