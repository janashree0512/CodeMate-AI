# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables and secrets (CRITICAL: Never commit credentials)
.env
.env.local
.env.*.local

# Virtual Environments
venv/
.venv/
env/
ENV/
build/
dist/
*.egg-info/

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit Local Runtime & Secrets
.streamlit/secrets.toml

# Sandboxed Workspace Output (Ignore files generated by the agent, preserve folder)
workspace/*
!workspace/.gitkeep

# IDE & Editor Specific
.vscode/
.idea/
*.swp
*.swo

# Operating System Files
.DS_Store
Thumbs.db
